# Mapillary Graph API access token.
# Obtain one at https://www.mapillary.com/developer.
MAPILLARY_ACCESS_TOKEN=

# Password for the local citydb-postgres service (any value; only used inside
# the docker network). Required for stages 4-5 (enrich, visualize).
BFE_CITYDB_PASSWORD=citydb

# Optional overrides for the citydb-postgres service.
# BFE_CITYDB_NAME=heidelberg_citydb5
# BFE_CITYDB_SRID=25832
# BFE_CITYDB_SRS_NAME=urn:ogc:def:crs:EPSG::25832

# Optional fallback CRS used by the stage 0 extractor when the CityGML
# envelopes have no srsName. Heidelberg CityGML is EPSG:25832.
# BFE_CITYGML_CRS=EPSG:25832
